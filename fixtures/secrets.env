# Test credentials for the harness. Committed deliberately: none of these are
# real, and a bot under test must never reach for the live ones.
#
# `run-bot.sh` points BOT_SECRETS_FILE at this file, so a converted bot loads
# these instead of ~/.config/botlib/secrets.env.
#
# The values here are not arbitrary. They reproduce exactly what run-bot.sh's
# sed rewrite injects into an unconverted bot, so that converting a bot does
# not change its captured requests:
#
#   - every MASTODON_TOKEN becomes test-mastodon-token
#   - every MASTODON_SERVER becomes https://mastodon.social, which is where
#     every bot's account now lives. botgov and moonstriker still carry a
#     hardcoded botsin.space in their unconverted scripts; converting them
#     picks up the correct server from here.
#   - every BLUESKY_APP_PASSWORD / BLUESKY_PASSWORD becomes test-app-password
#   - BLUESKY_HANDLE is NOT rewritten, so each bot keeps whatever its script
#     holds today -- including the literal placeholders that rejected-plates
#     and finds-you ship with, which appear verbatim in their goldens
#
# Change a value here and the corresponding golden must be re-baselined.

# Shared: no Slack under the harness. core.sh suppresses delivery whenever
# HARNESS_CAPTURE is set, so this is belt and braces.
SLACK_WEBHOOK_URL=""

BOT_VACATION_BLUESKY_SERVER="https://bsky.social"
BOT_VACATION_BLUESKY_HANDLE="xmasvacation.bsky.social"
BOT_VACATION_BLUESKY_APP_PASSWORD="test-app-password"
BOT_VACATION_S3_BUCKET="s3://bot-vacation.jaquith.org/"

BOTGOV_MASTODON_SERVER="https://mastodon.social"
BOTGOV_MASTODON_TOKEN="test-mastodon-token"

BOUS_MASTODON_SERVER="https://mastodon.social"
BOUS_MASTODON_TOKEN="test-mastodon-token"
BOUS_BLUESKY_HANDLE="botofunusualsize.bsky.social"
BOUS_BLUESKY_APP_PASSWORD="test-app-password"
BOUS_S3_BUCKET="s3://bous.jaquith.org/"

COVID_WASTEWATER_MASTODON_SERVER="https://mastodon.social"
COVID_WASTEWATER_MASTODON_TOKEN="test-mastodon-token"

DREAMBOT_MASTODON_SERVER="https://mastodon.social"
DREAMBOT_MASTODON_TOKEN="test-mastodon-token"

FEATURING_SUPER_CAT_MASTODON_SERVER="https://mastodon.social"
FEATURING_SUPER_CAT_MASTODON_TOKEN="test-mastodon-token"
FEATURING_SUPER_CAT_BLUESKY_HANDLE="feat-super-cat.bsky.social"
FEATURING_SUPER_CAT_BLUESKY_APP_PASSWORD="test-app-password"
FEATURING_SUPER_CAT_S3_BUCKET="s3://super-cat.jaquith.org/"

FINDS_YOU_MASTODON_SERVER="https://mastodon.social"
FINDS_YOU_MASTODON_TOKEN="test-mastodon-token"
FINDS_YOU_BLUESKY_SERVER="https://bsky.social"
FINDS_YOU_BLUESKY_HANDLE="thisemailfindsyou.bsky.social"
FINDS_YOU_BLUESKY_APP_PASSWORD="test-app-password"

MOONSTRIKER_MASTODON_SERVER="https://mastodon.social"
MOONSTRIKER_MASTODON_TOKEN="test-mastodon-token"
MOONSTRIKER_S3_BUCKET="s3://moonstruck.jaquith.org/clips/"

# Likewise: {{BLUESKY_HANDLE}} appears verbatim in rejected-plates' goldens as
# both the createSession identifier and the createRecord repo
REJECTED_PLATES_MASTODON_SERVER="https://mastodon.social"
REJECTED_PLATES_MASTODON_TOKEN="test-mastodon-token"
REJECTED_PLATES_BLUESKY_HANDLE="{{BLUESKY_HANDLE}}"
REJECTED_PLATES_BLUESKY_APP_PASSWORD="test-app-password"
